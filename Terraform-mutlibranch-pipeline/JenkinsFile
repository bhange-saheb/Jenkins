pipeline {
    agent none
    environment {
        PROJECT = 'WELCOME TO Jenkins-Terraform Modules Pipeline'
        TERRAFORM_MODULE_REPO = 'https://github.com/bhange-saheb/Terraform.git'
    }
    stages {
        stage('For Parallel Stages') {
            parallel {
                stage('Deploy To Development') {
                    agent { label 'dev' }
                    environment {
                        DEV_AWS_ACCOUNT = '680464296394'
                        DEVDEFAULTAMI = 'ami-065292e2b63f3fd8f'
                        TERRAFORM_APPLY = 'YES' // Set to YES to trigger apply
                        TERRAFORM_DESTROY = 'NO' // Set to YES if you want to destroyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
                    }
                    when {
                        branch 'dev'
                    }
                    stages {
                        stage('Clone Terraform Modules') {
                            steps {
                                sh 'pwd'
                                sh 'rm -rf terraform-modules'
                                sh 'ls -al'
                                sh "git clone ${TERRAFORM_MODULE_REPO} terraform-modules"
                                dir('terraform-modules/terrraform-modules') {
                                    sh 'ls -al'
                                }
                                sh 'ls -al terraform-modules/terrraform-modules/devlopement-env'
                                sh 'find terraform-modules/terrraform-modules/devlopement-env -name "*.tf"'
                            }
                        }
                        stage('Terraform Init & Plan') {
                            when {
                                expression {
                                    "${env.TERRAFORM_APPLY}" == 'YES'
                                }
                            }
                            steps {
                                dir('terraform-modules/terrraform-modules/devlopement-env') {  // Navigate to development directory
                                    sh 'terraform init'
                                    sh 'terraform validate'
                                    sh 'terraform plan -var-file=terraform.tfvars'
                                }
                            }
                        }
                        stage('Terraform Apply') {
                            when {
                                expression {
                                    "${env.TERRAFORM_APPLY}" == 'YES'
                                }
                            }
                            steps {
                                dir('terraform-modules/terrraform-modules/devlopement-env') {
                                    sh 'terraform apply -var-file=terraform.tfvars --auto-approve'
                                }
                            }
                        }
                        stage('Terraform Destroy') {
                            when {
                                expression {
                                    "${env.TERRAFORM_DESTROY}" == 'YES'
                                }
                            }
                            steps {
                                dir('terraform-modules/terrraform-modules/devlopement-env') {
                                    sh 'terraform init'
                                    sh 'terraform validate'
                                    sh 'terraform destroy -var-file=terraform.tfvars --auto-approve'
                                }
                            }
                        }
                    }
                }

        //             stage('Deploy To Production') {
        //                 agent { label 'PROD' }
        //                 environment {
        //                     PROD_AWS_ACCOUNT = "009412611595"
        //                     PRODEFAULTAMI = "ami-0f45852828028bd50"
        //                     TERRAFORM_APPLY = "YES" // Set to YES to trigger apply
        //                     TERRAFORM_DESTROY = "NO" // Set to YES if you want to destroy
        //                 }
        //                 when {
        //                     branch 'production'
        //                 }
        //                 stages {
        //                     stage('Clone Terraform Modules') {
        //                         steps {
        //                             sh 'pwd'
        //                             sh 'ls -al'
        //                             sh "git clone ${TERRAFORM_MODULE_REPO} terraform-modules"
        //                             sh 'ls -al terraform-modules/production'
        //                             sh 'find terraform-modules/production -name "*.tf"'
        //                         }
        //                     }
        //                     stage('Terraform Init & Plan') {
        //                         when {
        //                             expression {
        //                                 "${env.TERRAFORM_APPLY}" == 'YES'
        //                             }
        //                         }
        //                         steps {
        //                             dir('terraform-modules/production') {  // Navigate to production directory
        //                                 sh 'terraform init'
        //                                 sh 'terraform validate'
        //                                 sh 'terraform plan -var-file=terraform.tfvars'
        //                             }
        //                         }
        //                     }
        //                     stage('Terraform Apply') {
        //                         when {
        //                             expression {
        //                                 "${env.TERRAFORM_APPLY}" == 'YES'
        //                             }
        //                         }
        //                         steps {
        //                             dir('terraform-modules/production') {
        //                                 sh 'terraform apply -var-file=terraform.tfvars --auto-approve'
        //                             }
        //                         }
        //                     }
        //                     stage('Terraform Destroy') {
        //                         when {
        //                             expression {
        //                                 "${env.TERRAFORM_DESTROY}" == 'YES'
        //                             }
        //                         }
        //                         steps {
        //                             dir('terraform-modules/production') {
        //                                 sh 'terraform destroy -var-file=terraform.tfvars --auto-approve'
        //                             }
        //                         }
        //                     }
        //                 }
        //             }
        //         }
        }
    }
        post {
            success {
                slackSend(color: 'good', message: "Pipeline Successful: ${env.JOB_NAME} ${env.BUILD_NUMBER} ${env.BUILD_URL}")
            }
            failure {
                slackSend(color: 'danger', message: "Pipeline Failed: ${env.JOB_NAME} ${env.BUILD_NUMBER} ${env.BUILD_URL}")
            }
            aborted {
                slackSend(color: 'warning', message: "Pipeline Aborted: ${env.JOB_NAME} ${env.BUILD_NUMBER} ${env.BUILD_URL}")
            }
            always {
                echo 'I always run.'
            }
        }
}
}
